// Jenkins CI for Windows-specific builds of the AudioVisualizer solution
//
// This pipeline runs on a Windows agent and builds the MSI installer
// using WiX Toolset v6.0.2. The default Jenkinsfile already builds the
// installer because it also runs on Windows; this file is kept for jobs
// that publish the MSI as a first-class artifact.
//
// Prerequisites:
//   * A .NET 10 SDK on PATH
//   * Jenkins MSTest plugin for test results
//

pipeline {
    agent { label 'Windows-Agent' }
    triggers {
        githubPush()
    }

    options {
        buildDiscarder(logRotator(numToKeepStr: '15', artifactNumToKeepStr: '15'))
        disableConcurrentBuilds()
        timeout(time: 30, unit: 'MINUTES')
    }

    environment {
        CONFIGURATION               = 'Release'
        DOTNET_CLI_TELEMETRY_OPTOUT = '1'
        DOTNET_NOLOGO               = '1'
        DOTNET_SKIP_FIRST_TIME_EXPERIENCE = '1'
        DOTNET_CLI_HOME             = "${WORKSPACE}/.dotnet"
        SOLUTION                    = 'AudioVisualizer.slnx'
        INSTALLER_DIR               = 'installer'
        ARTIFACT_DIR                = 'artifacts'
    }

    stages {
        stage('Verify SDK') {
            steps {
                bat 'dotnet --version'
                bat 'dotnet --info'
            }
        }

        stage('Restore') {
            steps {
                bat "dotnet restore ${SOLUTION}"
            }
        }

        stage('Build') {
            steps {
                bat "dotnet build ${SOLUTION} --configuration ${CONFIGURATION} --no-restore --warnaserror"
            }
        }

        stage('Test') {
            steps {
                script {
                    def testProjects = findFiles(glob: '**/*Tests.csproj').findAll {
                        !it.path.contains('/bin/') && !it.path.contains('/obj/')
                    }

                    if (testProjects) {
                        bat 'if exist TestResults rmdir /s /q TestResults'
                        // cmd.exe does not strip single quotes, so quoting the
                        // logger value passes "'trx" to dotnet and fails.
                        bat "dotnet test ${SOLUTION} --configuration ${CONFIGURATION} --no-build --logger trx --results-directory TestResults"
                        env.TESTS_RUN = 'true'
                    } else {
                        echo 'No test projects found; skipping dotnet test.'
                        env.TESTS_RUN = 'false'
                    }
                }
            }
            post {
                always {
                    script {
                        if (env.TESTS_RUN == 'true' &&
                            findFiles(glob: 'TestResults/**/*.trx').length > 0) {
                            mstest testResultsFile: 'TestResults/**/*.trx', keepLongStdio: true
                        }
                    }
                }
            }
        }

        stage('Build Installer') {
            steps {
                // The WiX project publishes a self-contained, single-file
                // win-x64 build and packages it into the MSI.
                bat "dotnet build ${INSTALLER_DIR}/AudioVisualizer.Installer.wixproj --configuration ${CONFIGURATION}"
            }
            post {
                success {
                    script {
                        bat "if not exist ${ARTIFACT_DIR} mkdir ${ARTIFACT_DIR}"
                        bat "copy /y ${INSTALLER_DIR}\\bin\\x64\\${CONFIGURATION}\\AudioVisualizer.msi ${ARTIFACT_DIR}\\"
                    }
                }
            }
        }
    }

    post {
        success {
            archiveArtifacts artifacts: "${ARTIFACT_DIR}/*.msi", fingerprint: true
        }
        always {
            echo "Build ${env.BUILD_NUMBER} finished: ${currentBuild.currentResult}"
        }
    }
}
