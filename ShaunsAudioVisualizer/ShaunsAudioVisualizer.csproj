<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Authors>Shaun McCloud</Authors>
    <Version>0.4.0</Version>
    <ApplicationIcon>app-icon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" />
    <EmbeddedResource Include="app-icon.ico" />
    <EmbeddedResource Include="vumeter.png" />
    <EmbeddedResource Include="LockChime.mp3" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ShaunsAudioVisualizer.Tests" />
    <InternalsVisibleTo Include="ShaunsAudioVisualizer.Windows.Tests" />  </ItemGroup>

</Project>
